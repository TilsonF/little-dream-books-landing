---
---

<section class="about-section" id="about">
  <!-- Background decorative blobs -->
  <div class="about-blob about-blob-1" aria-hidden="true"></div>
  <div class="about-blob about-blob-2" aria-hidden="true"></div>

  <div class="container about-inner">
    <!-- Left: Illustration -->
    <div class="about-visual">
      <div class="about-frame">
        <!-- Decorative corner -->
        <div class="frame-sparkle top-left">✦</div>
        <div class="frame-sparkle top-right">✧</div>
        <div class="frame-sparkle bottom-left">✧</div>

        <!-- Scene -->
        <div class="about-scene">
          <div class="scene-night"></div>
          <div class="scene-glow"></div>
          <div class="about-stars">
            <span>✦</span><span>✧</span><span>✦</span>
            <span>✧</span><span>✦</span><span>✧</span>
            <span>✦</span><span>✧</span><span>✦</span>
          </div>
          <div class="about-lanterns">
            <span class="lantern l1">🏮</span>
            <span class="lantern l2">🏮</span>
            <span class="lantern l3">🏮</span>
            <span class="lantern l4">🏮</span>
          </div>
          <div class="about-fireflies">
            <span>✨</span><span>✨</span><span>✨</span>
            <span>✨</span><span>✨</span>
          </div>
          <div class="about-girl-large" aria-label="Isabella character">👧</div>
          <div class="about-ground"></div>
        </div>
      </div>

      <!-- Floating info badge -->
      <div class="about-badge">
        <span class="badge-number">4</span>
        <span class="badge-text">Magical<br />Adventures</span>
      </div>
    </div>

    <!-- Right: Text -->
    <div class="about-text">
      <span class="chip chip-lavender about-eyebrow">✦ Meet Our Hero</span>
      <h2 class="about-title">The Magic of<br /><span class="about-title-accent">Isabella's World</span></h2>
      <p class="about-desc">
        Our flagship series follows Isabella, a brave and imaginative girl
        who finds wonder in the everyday. From gardens that touch the stars
        to scientific discoveries at home, Isabella is more than just
        a character—she's a companion for your child's growth.
      </p>
      <p class="about-desc">
        Each book is crafted to spark bilingual conversations, encourage
        exploration, and give families a shared story they'll return to
        again and again.
      </p>

      <!-- Feature pills -->
      <div class="about-features">
        <div class="feature-pill">
          <span class="fp-icon">🌟</span>
          <div>
            <strong>Ages 4–8</strong>
            <span>Developmentally crafted</span>
          </div>
        </div>
        <div class="feature-pill">
          <span class="fp-icon">🌐</span>
          <div>
            <strong>EN / ES</strong>
            <span>Full bilingual text</span>
          </div>
        </div>
        <div class="feature-pill">
          <span class="fp-icon">🎨</span>
          <div>
            <strong>Activity Pages</strong>
            <span>Interactive content</span>
          </div>
        </div>
      </div>

      <a
        href="https://amazon.com"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
        id="discover-btn"
      >
        Discover Her Story
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    padding: var(--space-xl) 0;
    background: var(--primary);
    overflow: hidden;
    color: white;
  }

  /* Blobs */
  .about-blob {
    position: absolute;
    border-radius: 60% 40% 70% 30% / 50% 60% 40% 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .about-blob-1 {
    width: 500px;
    height: 400px;
    background: rgba(91, 88, 140, 0.4);
    top: -100px;
    right: -100px;
  }

  .about-blob-2 {
    width: 300px;
    height: 240px;
    background: rgba(116, 160, 161, 0.25);
    bottom: -60px;
    left: -60px;
  }

  /* Layout */
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* Visual */
  .about-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .about-frame {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
    border-radius: var(--radius-xl);
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 80px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(195, 192, 255, 0.2);
  }

  .frame-sparkle {
    position: absolute;
    font-size: 18px;
    color: rgba(195, 192, 255, 0.6);
    z-index: 10;
    animation: sparklePulse 2s ease-in-out infinite;
  }

  .top-left { top: 16px; left: 16px; }
  .top-right { top: 16px; right: 16px; animation-delay: 0.5s; }
  .bottom-left { bottom: 16px; left: 16px; animation-delay: 1s; }

  @keyframes sparklePulse {
    0%, 100% { opacity: 0.3; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .about-scene {
    width: 100%;
    height: 100%;
    position: relative;
    background: linear-gradient(160deg, #0d0825 0%, #1e1556 40%, #0a1628 100%);
  }

  .scene-night {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 30%, #2c1f6b 0%, #0d1032 70%);
  }

  .scene-glow {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translateX(-50%);
    width: 160px;
    height: 160px;
    background: radial-gradient(circle, rgba(195, 192, 255, 0.25) 0%, transparent 70%);
    border-radius: 50%;
    animation: glowPulse 3s ease-in-out infinite;
  }

  @keyframes glowPulse {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.6; }
    50% { transform: translateX(-50%) scale(1.3); opacity: 1; }
  }

  .about-stars {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 55%;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 16px;
    justify-content: space-around;
    align-items: flex-start;
  }

  .about-stars span {
    color: rgba(240, 230, 255, 0.7);
    font-size: 14px;
    animation: twinkle 2.5s ease-in-out infinite;
  }

  .about-stars span:nth-child(even) { animation-delay: 0.6s; font-size: 9px; }
  .about-stars span:nth-child(3n) { animation-delay: 1.2s; }

  @keyframes twinkle {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.9; }
  }

  .about-lanterns {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .lantern {
    position: absolute;
    font-size: 24px;
    animation: lanternFloat 5s ease-in-out infinite;
    filter: drop-shadow(0 0 12px rgba(255, 200, 100, 0.6));
  }

  .l1 { top: 20%; left: 15%; animation-delay: 0s; }
  .l2 { top: 35%; right: 20%; animation-delay: 1.2s; }
  .l3 { top: 55%; left: 25%; animation-delay: 2.4s; font-size: 18px; }
  .l4 { top: 25%; left: 55%; animation-delay: 0.8s; font-size: 20px; }

  @keyframes lanternFloat {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-16px) rotate(3deg); }
  }

  .about-fireflies {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .about-fireflies span {
    position: absolute;
    font-size: 10px;
    animation: fireflyMove 4s ease-in-out infinite;
  }

  .about-fireflies span:nth-child(1) { top: 45%; left: 20%; animation-delay: 0s; }
  .about-fireflies span:nth-child(2) { top: 60%; right: 25%; animation-delay: 0.8s; }
  .about-fireflies span:nth-child(3) { top: 40%; right: 15%; animation-delay: 1.6s; }
  .about-fireflies span:nth-child(4) { top: 65%; left: 40%; animation-delay: 2.4s; }
  .about-fireflies span:nth-child(5) { top: 50%; left: 60%; animation-delay: 3.2s; }

  @keyframes fireflyMove {
    0%, 100% { opacity: 0.2; transform: translate(0, 0); }
    50% { opacity: 1; transform: translate(8px, -10px); }
  }

  .about-girl-large {
    position: absolute;
    bottom: 25%;
    left: 50%;
    transform: translateX(-50%);
    font-size: 80px;
    z-index: 5;
    filter: drop-shadow(0 6px 30px rgba(195, 192, 255, 0.6));
    animation: girlFloat 5s ease-in-out infinite;
  }

  @keyframes girlFloat {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-10px); }
  }

  .about-ground {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 28%;
    background: linear-gradient(to top, #1a6b3c, #0f4426);
    border-radius: 60% 60% 0 0 / 30% 30% 0 0;
  }

  /* Badge */
  .about-badge {
    position: absolute;
    bottom: -16px;
    right: 20px;
    background: white;
    border-radius: var(--radius-lg);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.2);
  }

  .badge-number {
    font-family: var(--font-brand);
    font-size: 32px;
    font-weight: 700;
    color: var(--primary);
    line-height: 1;
  }

  .badge-text {
    font-family: var(--font-brand);
    font-size: 12px;
    font-weight: 600;
    color: var(--on-surface-variant);
    line-height: 1.4;
  }

  /* Text side */
  .about-eyebrow {
    display: inline-flex;
    margin-bottom: 16px;
    background: rgba(195, 192, 255, 0.2);
    color: var(--lavender);
    border: 1px solid rgba(195, 192, 255, 0.3);
  }

  .about-title {
    font-family: var(--font-brand);
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 700;
    color: white;
    line-height: 1.2;
    margin-bottom: 20px;
  }

  .about-title-accent {
    color: var(--lavender);
  }

  .about-desc {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  /* Feature pills */
  .about-features {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }

  .feature-pill {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(195, 192, 255, 0.15);
    border-radius: var(--radius-lg);
    padding: 12px 16px;
    backdrop-filter: blur(8px);
    transition: background 0.2s ease;
  }

  .feature-pill:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .fp-icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  .feature-pill div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .feature-pill strong {
    font-family: var(--font-brand);
    font-size: 14px;
    font-weight: 700;
    color: white;
  }

  .feature-pill span {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
  }

  .about-section .btn-primary {
    background: white;
    color: var(--primary);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .about-section .btn-primary:hover {
    background: var(--lavender-soft);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .about-visual {
      order: -1;
    }

    .about-frame {
      max-width: 320px;
    }
  }
</style>
