---
---

<section class="cta-section" id="cta">
  <!-- Decorative blobs -->
  <div class="cta-blob cta-blob-1" aria-hidden="true"></div>
  <div class="cta-blob cta-blob-2" aria-hidden="true"></div>

  <!-- Sparkles -->
  <div class="cta-sparkle sp1" aria-hidden="true">✦</div>
  <div class="cta-sparkle sp2" aria-hidden="true">✧</div>
  <div class="cta-sparkle sp3" aria-hidden="true">✦</div>
  <div class="cta-sparkle sp4" aria-hidden="true">✧</div>

  <div class="container cta-inner">
    <!-- Moon illustration -->
    <div class="cta-moon" aria-hidden="true">🌙</div>

    <h2 class="cta-title">
      Lleva a Casa un Poco Más de<br />
      <span class="cta-title-accent">Magia</span> Hoy
    </h2>

    <p class="cta-desc">
      Únete a miles de familias que terminan sus días con una pizca de asombro
      y la alegría de un nuevo idioma.
    </p>

    <!-- Star rating -->
    <div class="cta-rating">
      <span class="cta-stars">★★★★★</span>
      <span class="cta-rating-text">+500 reseñas de 5 estrellas en Amazon</span>
    </div>

    <a
      href="https://amazon.com"
      target="_blank"
      rel="noopener noreferrer"
      class="cta-btn"
      id="final-cta-btn"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/>
      </svg>
      Comprar Colección en Amazon
    </a>

    <!-- Small trust text -->
    <p class="cta-trust">
      🔒 Pago seguro &nbsp;·&nbsp; 🚚 Envío rápido &nbsp;·&nbsp; 💖 Hecho con amor
    </p>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    padding: var(--space-xl) 0;
    background: var(--primary);
    overflow: hidden;
    text-align: center;
  }

  /* Blobs */
  .cta-blob {
    position: absolute;
    border-radius: 60% 40% 70% 30% / 50% 60% 40% 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .cta-blob-1 {
    width: 500px;
    height: 400px;
    background: rgba(91, 88, 140, 0.45);
    top: -100px;
    left: -100px;
    animation: blobMove 10s ease-in-out infinite;
  }

  .cta-blob-2 {
    width: 400px;
    height: 320px;
    background: rgba(116, 160, 161, 0.3);
    bottom: -80px;
    right: -80px;
    animation: blobMove 12s ease-in-out infinite reverse;
  }

  @keyframes blobMove {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(20px, -20px) rotate(5deg); }
    66% { transform: translate(-15px, 15px) rotate(-3deg); }
  }

  /* Sparkles */
  .cta-sparkle {
    position: absolute;
    font-size: 22px;
    color: rgba(195, 192, 255, 0.5);
    pointer-events: none;
    animation: sparklePulse 3s ease-in-out infinite;
  }

  .sp1 { top: 20%; left: 8%; font-size: 16px; animation-delay: 0s; }
  .sp2 { top: 15%; right: 10%; font-size: 22px; animation-delay: 0.6s; }
  .sp3 { bottom: 25%; left: 15%; font-size: 12px; animation-delay: 1.2s; }
  .sp4 { bottom: 20%; right: 8%; font-size: 18px; animation-delay: 1.8s; }

  @keyframes sparklePulse {
    0%, 100% { opacity: 0.2; transform: scale(0.9); }
    50% { opacity: 0.8; transform: scale(1.2); }
  }

  /* Inner */
  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  /* Moon */
  .cta-moon {
    font-size: 56px;
    filter: drop-shadow(0 4px 20px rgba(195, 192, 255, 0.5));
    animation: moonFloat 5s ease-in-out infinite;
  }

  @keyframes moonFloat {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-12px) rotate(5deg); }
  }

  /* Title */
  .cta-title {
    font-family: var(--font-brand);
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 700;
    color: white;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cta-title-accent {
    color: var(--lavender);
  }

  /* Desc */
  .cta-desc {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
    max-width: 520px;
  }

  /* Rating */
  .cta-rating {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    padding: 8px 20px;
    backdrop-filter: blur(8px);
  }

  .cta-stars {
    color: #ffd700;
    font-size: 18px;
    letter-spacing: 2px;
  }

  .cta-rating-text {
    font-family: var(--font-brand);
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Button */
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: white;
    color: var(--primary);
    font-family: var(--font-brand);
    font-size: 17px;
    font-weight: 700;
    padding: 18px 40px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.25s ease;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.25);
    margin-top: 4px;
  }

  .cta-btn:hover {
    transform: scale(1.07);
    box-shadow: 0 16px 60px rgba(0, 0, 0, 0.35);
    background: var(--lavender-soft);
  }

  /* Trust */
  .cta-trust {
    font-family: var(--font-brand);
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 600px) {
    .cta-title { font-size: 30px; }
    .cta-desc { font-size: 16px; }
    .cta-btn { font-size: 15px; padding: 15px 28px; }
    .cta-rating { flex-direction: column; gap: 4px; }
  }
</style>
