---
const benefits = [
  {
    id: "spark-creativity",
    icon: "💡",
    title: "Despierta la Creatividad",
    desc: "Narrativas abiertas que animan a los niños a preguntar '¿Qué pasaría si...?' y explorar su imaginación.",
    color: "var(--pink)",
    textColor: "var(--pink-text)",
  },
  {
    id: "language-growth",
    icon: "🌐",
    title: "Desarrollo del Lenguaje",
    desc: "Textos bilingües naturales y conversacionales para un aprendizaje fácil en inglés y español.",
    color: "var(--lavender-soft)",
    textColor: "var(--on-secondary-container)",
  },
  {
    id: "screen-free",
    icon: "📵",
    title: "Sin Pantallas",
    desc: "Hermosos libros que alejan a los niños de los dispositivos y los llevan a mundos mágicos.",
    color: "var(--mint)",
    textColor: "var(--mint-text)",
  },
  {
    id: "better-sleep",
    icon: "🌙",
    title: "Mejor Sueño",
    desc: "Ritmos calmantes e ilustraciones suaves diseñadas específicamente para la rutina de dormir.",
    color: "var(--sky-soft)",
    textColor: "#1a5c6b",
  },
  {
    id: "perfect-gifts",
    icon: "🎁",
    title: "El Regalo Perfecto",
    desc: "Volúmenes impresos de alta calidad que lucen increíbles y son el regalo perfecto.",
    color: "var(--yellow)",
    textColor: "var(--yellow-text)",
  },
  {
    id: "family-bonding",
    icon: "👨‍👩‍👧",
    title: "Vínculo Familiar",
    desc: "Crea tiempo dedicado para que padres e hijos se conecten a través de la lectura compartida.",
    color: "var(--lavender-soft)",
    textColor: "var(--on-secondary-container)",
  },
];
---

<section class="benefits-section" id="benefits">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <h2 class="section-title">Por Qué a los Padres les Encantan Nuestros Libros</h2>
      <div class="title-underline" aria-hidden="true"></div>
      <p class="section-subtitle" style="margin-top:16px;">
        Diseñado pensando en los expertos en desarrollo infantil y en los padres—porque
        la hora del cuento debe ser mágica <em>y</em> significativa.
      </p>
    </div>

    <!-- Grid -->
    <div class="benefits-grid">
      {
        benefits.map((b) => (
          <div class="benefit-card" id={b.id}>
            <div
              class="benefit-icon-wrap"
              style={`background: ${b.color}; color: ${b.textColor};`}
            >
              <span class="benefit-icon" role="img" aria-label={b.title}>
                {b.icon}
              </span>
            </div>
            <h3 class="benefit-title">{b.title}</h3>
            <p class="benefit-desc">{b.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .benefits-section {
    padding: var(--space-xl) 0;
    background: var(--surface-container-low);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .title-underline {
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, var(--secondary), var(--sky));
    border-radius: var(--radius-full);
    margin: 12px auto 0;
  }

  /* Grid */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* Card */
  .benefit-card {
    background: white;
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    box-shadow: var(--shadow-card);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .benefit-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-float);
  }

  .benefit-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .benefit-card:hover .benefit-icon-wrap {
    transform: scale(1.12) rotate(-3deg);
  }

  .benefit-icon {
    font-size: 24px;
    line-height: 1;
  }

  .benefit-title {
    font-family: var(--font-brand);
    font-size: 17px;
    font-weight: 700;
    color: var(--primary);
    line-height: 1.3;
  }

  .benefit-desc {
    font-size: 14px;
    color: var(--on-surface-variant);
    line-height: 1.65;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
