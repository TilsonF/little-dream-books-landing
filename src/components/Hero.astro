---
import booksData from "../data/books.json";

const isabellaCover = booksData.books[0]?.coverUrl || booksData.books[0]?._raw?.["B0H2H7NFJQ"]?.coverUrl || "";
---

<section class="hero" id="hero">
  <!-- Floating decorative blobs -->
  <div class="blob-bg blob-1" aria-hidden="true"></div>
  <div class="blob-bg blob-2" aria-hidden="true"></div>
  <div class="blob-bg blob-3" aria-hidden="true"></div>

  <!-- Stars/sparkles -->
  <div class="sparkle s1" aria-hidden="true">✦</div>
  <div class="sparkle s2" aria-hidden="true">✧</div>
  <div class="sparkle s3" aria-hidden="true">✦</div>
  <div class="sparkle s4" aria-hidden="true">✧</div>
  <div class="sparkle s5" aria-hidden="true">✦</div>

  <div class="container hero-inner">
    <!-- Left: Text -->
    <div class="hero-text">
      <span class="hero-eyebrow chip chip-lavender">
        ✨ Inspirando Mentes Jóvenes
      </span>

      <h1 class="hero-title">
        Libros Mágicos para<br />
        <span class="title-gradient">Pequeños<br />Soñadores</span>
      </h1>

      <p class="hero-desc">
        Cuentos mágicos en inglés y español diseñados para nutrir la
        imaginación, desarrollar habilidades lingüísticas y crear hermosos
        momentos en familia.
      </p>

      <div class="hero-ctas">
        <a href="#books" class="btn-primary" id="explore-btn">
          Explorar Colección
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="#about" class="btn-secondary" id="learn-more-btn">Descubre a Isabella</a>
      </div>

      <!-- Trust badges -->
      <div class="trust-badges">
        <div class="trust-item">
          <span class="trust-icon">⭐</span>
          <span class="trust-text">+500 Reseñas</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">🌍</span>
          <span class="trust-text">Bilingüe</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">🏆</span>
          <span class="trust-text">Galardonados</span>
        </div>
      </div>
    </div>

    <!-- Right: Book illustration -->
    <div class="hero-visual">
      <!-- Floating badges -->
      <div class="float-badge badge-top" id="coloring-badge">
        <span>🎨</span> Diversión para Colorear
      </div>
      <div class="float-badge badge-bottom" id="stories-badge">
        <span>📚</span> Historias Bilingües
      </div>
      <div class="float-badge badge-activity" id="activity-badge">
        <span>✏️</span> Actividades Creativas
      </div>

      <!-- Book cover card -->
      <div class="book-card" id="hero-book-card">
        <div class="book-cover">
          {isabellaCover ? (
             <img src={isabellaCover} alt="Isabella and the Garden of Stars" class="real-book-cover" />
          ) : (
            <div class="book-illustration">
              <!-- Illustrated scene fallback -->
              <div class="scene-sky"></div>
              <div class="scene-stars">
                <span>✦</span><span>✧</span><span>✦</span><span>✧</span>
                <span>✦</span><span>✧</span><span>✦</span><span>✧</span>
              </div>
              <div class="scene-ground"></div>
              <div class="scene-flowers">
                <span>🌸</span><span>🌺</span><span>🌸</span>
              </div>
              <div class="scene-fireflies">
                <span class="ff ff1">✨</span>
                <span class="ff ff2">✨</span>
                <span class="ff ff3">✨</span>
                <span class="ff ff4">✨</span>
              </div>
              <div class="scene-girl" aria-label="Isabella illustration">👧</div>
              <div class="book-title-overlay">
                <span class="book-title-line1">Isabella</span>
                <span class="book-title-line2">y el Jardín</span>
                <span class="book-title-line3">de las Estrellas</span>
              </div>
            </div>
          )}
          <div class="book-badge">
            <span class="chip chip-mint">NUEVO</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats bar -->
  <div class="stats-bar">
    <div class="container stats-inner">
      <div class="stat-item">
        <span class="stat-icon">👶</span>
        <span class="stat-label">Edades 4-8</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-icon">🌐</span>
        <span class="stat-label">Bilingüe</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-icon">📵</span>
        <span class="stat-label">Sin Pantallas</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-icon">🎓</span>
        <span class="stat-label">Educativos</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 120px;
    padding-bottom: 0;
    overflow: hidden;
    background: linear-gradient(
      155deg,
      #fcf8fd 0%,
      #f0ecff 40%,
      #e8f5ff 100%
    );
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Blob backgrounds */
  .blob-bg {
    position: absolute;
    border-radius: 60% 40% 70% 30% / 50% 60% 40% 50%;
    filter: blur(60px);
    pointer-events: none;
    opacity: 0.45;
  }

  .blob-1 {
    width: 480px;
    height: 380px;
    background: radial-gradient(circle, #c3c0ff 0%, #e3dfff 70%);
    top: -80px;
    right: -60px;
    animation: blobFloat 8s ease-in-out infinite;
  }

  .blob-2 {
    width: 320px;
    height: 260px;
    background: radial-gradient(circle, #bdebeb 0%, #e0f8f8 70%);
    bottom: 80px;
    left: -80px;
    animation: blobFloat 10s ease-in-out infinite reverse;
  }

  .blob-3 {
    width: 220px;
    height: 180px;
    background: radial-gradient(circle, #ffd6e7 0%, #fff0f6 70%);
    top: 40%;
    left: 30%;
    animation: blobFloat 12s ease-in-out infinite 2s;
    opacity: 0.25;
  }

  @keyframes blobFloat {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(12px, -18px) rotate(3deg); }
    66% { transform: translate(-8px, 12px) rotate(-2deg); }
  }

  /* Sparkles */
  .sparkle {
    position: absolute;
    color: var(--lavender-dark);
    font-size: 20px;
    opacity: 0.4;
    pointer-events: none;
    animation: sparklePulse 3s ease-in-out infinite;
  }
  .s1 { top: 18%; left: 8%; animation-delay: 0s; font-size: 14px; }
  .s2 { top: 32%; left: 48%; animation-delay: 0.6s; font-size: 10px; }
  .s3 { top: 60%; left: 80%; animation-delay: 1.2s; font-size: 16px; }
  .s4 { top: 75%; left: 20%; animation-delay: 1.8s; font-size: 12px; }
  .s5 { top: 15%; right: 5%; animation-delay: 0.9s; font-size: 18px; }

  @keyframes sparklePulse {
    0%, 100% { opacity: 0.2; transform: scale(0.9); }
    50% { opacity: 0.7; transform: scale(1.15); }
  }

  /* Hero inner layout */
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    flex: 1;
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  /* Hero text */
  .hero-eyebrow {
    display: inline-flex;
    margin-bottom: var(--space-sm);
    font-size: 13px;
  }

  .hero-title {
    font-family: var(--font-brand);
    font-size: clamp(36px, 5vw, 52px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
  }

  .title-gradient {
    background: linear-gradient(135deg, #454173 0%, #7b78d0 60%, #74a0a1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 18px;
    color: var(--on-surface-variant);
    line-height: 1.7;
    margin-bottom: var(--space-md);
    max-width: 460px;
  }

  .hero-ctas {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  /* Trust badges */
  .trust-badges {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-brand);
    font-size: 13px;
    font-weight: 600;
    color: var(--on-surface-variant);
  }

  .trust-icon {
    font-size: 16px;
  }

  /* Hero visual */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 500px;
  }

  /* Floating badges */
  .float-badge {
    position: absolute;
    background: white;
    border-radius: var(--radius-lg);
    padding: 10px 16px;
    font-family: var(--font-brand);
    font-size: 13px;
    font-weight: 700;
    color: var(--primary);
    box-shadow: var(--shadow-card);
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 10;
    animation: floatBadge 4s ease-in-out infinite;
    backdrop-filter: blur(8px);
  }

  .badge-top {
    top: 5%;
    right: 0%;
    animation-delay: 0s;
    background: rgba(189, 235, 235, 0.9);
    color: var(--primary);
  }

  .badge-bottom {
    bottom: 18%;
    right: -2%;
    animation-delay: 1s;
    background: rgba(227, 223, 255, 0.95);
  }

  .badge-activity {
    bottom: 30%;
    left: 0%;
    animation-delay: 2s;
    background: rgba(255, 243, 196, 0.95);
    color: var(--yellow-text);
  }

  @keyframes floatBadge {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }

  /* Book card */
  .book-card {
    width: 280px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-float);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    z-index: 5;
    animation: bookFloat 6s ease-in-out infinite;
  }

  @keyframes bookFloat {
    0%, 100% { transform: translateY(0px) rotate(-1deg); }
    50% { transform: translateY(-14px) rotate(0.5deg); }
  }

  .book-card:hover {
    transform: translateY(-10px) rotate(0deg) scale(1.03);
    animation: none;
  }

  .book-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    background: linear-gradient(160deg, #1e1556 0%, #2e2a5b 40%, #0d1f3c 100%);
    overflow: hidden;
  }

  .real-book-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-illustration {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .scene-sky {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 30%, #2c1f6b 0%, #0d1032 60%, #000520 100%);
  }

  .scene-stars {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 60%;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 10px;
    justify-content: center;
  }

  .scene-stars span {
    color: #f0e6ff;
    font-size: 12px;
    opacity: 0.8;
    animation: twinkle 2s ease-in-out infinite;
  }

  .scene-stars span:nth-child(even) { animation-delay: 0.5s; font-size: 8px; opacity: 0.5; }
  .scene-stars span:nth-child(3n) { animation-delay: 1s; }

  @keyframes twinkle {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  .scene-ground {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 45%;
    background: linear-gradient(to top, #1a6b3c 0%, #2d9b5b 40%, transparent 100%);
    border-radius: 60% 60% 0 0 / 20% 20% 0 0;
  }

  .scene-flowers {
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 18px;
    z-index: 3;
    display: flex;
    justify-content: space-around;
    padding: 0 20px;
  }

  .scene-fireflies {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }

  .ff {
    position: absolute;
    font-size: 10px;
    animation: firefly 3s ease-in-out infinite;
  }
  .ff1 { top: 45%; left: 20%; animation-delay: 0s; }
  .ff2 { top: 55%; right: 25%; animation-delay: 0.8s; }
  .ff3 { top: 40%; right: 15%; animation-delay: 1.6s; }
  .ff4 { top: 62%; left: 35%; animation-delay: 2.4s; }

  @keyframes firefly {
    0%, 100% { opacity: 0.2; transform: translate(0,0) scale(0.8); }
    50% { opacity: 1; transform: translate(6px, -8px) scale(1.2); }
  }

  .scene-girl {
    position: absolute;
    bottom: 55px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 52px;
    z-index: 5;
    filter: drop-shadow(0 4px 20px rgba(195, 192, 255, 0.5));
    animation: girlFloat 5s ease-in-out infinite;
  }

  @keyframes girlFloat {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-6px); }
  }

  .book-title-overlay {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    text-align: center;
    z-index: 6;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .book-title-line1 {
    font-family: var(--font-brand);
    font-size: 22px;
    font-weight: 700;
    color: #f0e0ff;
    text-shadow: 0 2px 10px rgba(0,0,0,0.4);
    font-style: italic;
  }

  .book-title-line2,
  .book-title-line3 {
    font-family: var(--font-brand);
    font-size: 13px;
    font-weight: 600;
    color: #c3c0ff;
    text-shadow: 0 1px 6px rgba(0,0,0,0.4);
  }

  .book-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
  }

  /* Stats bar */
  .stats-bar {
    background: white;
    border-top: 1px solid var(--outline-variant);
    box-shadow: 0 -2px 20px rgba(46, 42, 91, 0.04);
    margin-top: auto;
  }

  .stats-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    height: 72px;
    flex-wrap: wrap;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 var(--space-md);
    flex: 1;
    justify-content: center;
    min-width: 120px;
  }

  .stat-icon {
    font-size: 20px;
  }

  .stat-label {
    font-family: var(--font-brand);
    font-size: 14px;
    font-weight: 600;
    color: var(--on-surface);
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--outline-variant);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-lg);
    }

    .hero-desc {
      max-width: 100%;
    }

    .hero-ctas {
      justify-content: center;
    }

    .trust-badges {
      justify-content: center;
    }

    .hero-visual {
      min-height: 380px;
      order: -1;
    }

    .book-card {
      width: 220px;
    }

    .blob-1 { width: 300px; height: 240px; }
    .blob-2 { width: 200px; height: 160px; }
  }

  @media (max-width: 500px) {
    .stat-divider { display: none; }
    .stats-inner { gap: 8px; height: auto; padding: 12px 0; }
    .stat-item { flex: none; min-width: 80px; }
  }
</style>
