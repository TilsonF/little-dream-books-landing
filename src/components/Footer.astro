---
const quickLinks = [
  { label: "Política de Privacidad", href: "#" },
  { label: "Términos de Servicio", href: "#" },
  { label: "Envíos", href: "#" },
  { label: "Ventas al Mayor", href: "#" },
];

const educatorsLinks = [
  { label: "Pedidos Grandes", href: "#" },
  { label: "Recursos para Maestros", href: "#" },
  { label: "Visitas Escolares", href: "#" },
];
---

<footer class="footer" id="footer">
  <div class="footer-top">
    <div class="container footer-grid">
      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <span class="footer-logo-icon">📖</span>
          <span class="footer-logo-text">Little Dream Books</span>
        </a>
        <p class="footer-tagline">
          Nutriendo la imaginación, una historia a la vez. Creamos tesoros bilingües 
          para familias que valoran el asombro, la educación y la magia de leer juntos.
        </p>
        <div class="footer-social">
          <a href="#" class="social-btn" id="social-instagram" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="#" class="social-btn" id="social-facebook" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" class="social-btn" id="social-tiktok" aria-label="TikTok">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9.03a8.18 8.18 0 004.78 1.52V7.1a4.85 4.85 0 01-1.02-.41z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick links -->
      <div class="footer-col">
        <h3 class="footer-col-title">Enlaces Rápidos</h3>
        <nav aria-label="Quick links">
          {quickLinks.map((link) => (
            <a href={link.href} class="footer-link">{link.label}</a>
          ))}
        </nav>
      </div>

      <!-- Educators -->
      <div class="footer-col">
        <h3 class="footer-col-title">Educadores</h3>
        <nav aria-label="Educator links">
          {educatorsLinks.map((link) => (
            <a href={link.href} class="footer-link">{link.label}</a>
          ))}
        </nav>

        <div class="footer-amazon-cta">
          <a
            href="https://amazon.com"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-amazon-btn"
            id="footer-amazon-btn"
          >
            🛍️ Comprar en Amazon
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copy">
        &copy; 2024 Little Dream Books. Nutriendo la imaginación, una historia a la vez.
      </p>
      <p class="footer-made">
        Hecho con <span class="heart">💖</span> para pequeños soñadores en todo el mundo.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--primary-container);
    color: var(--on-primary-container);
  }

  .footer-top {
    padding: 60px 0 48px;
    border-bottom: 1px solid rgba(151, 146, 202, 0.2);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  /* Brand */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    text-decoration: none;
  }

  .footer-logo-icon { font-size: 22px; }

  .footer-logo-text {
    font-family: var(--font-brand);
    font-size: 16px;
    font-weight: 700;
    color: white;
  }

  .footer-tagline {
    font-size: 14px;
    color: rgba(151, 146, 202, 0.9);
    line-height: 1.7;
    margin-bottom: 20px;
    max-width: 300px;
  }

  .footer-social {
    display: flex;
    gap: 10px;
  }

  .social-btn {
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(151, 146, 202, 0.25);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(151, 146, 202, 0.8);
    transition: background 0.2s, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s;
  }

  .social-btn:hover {
    background: rgba(195, 192, 255, 0.2);
    color: white;
    transform: translateY(-3px) scale(1.08);
  }

  /* Columns */
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col-title {
    font-family: var(--font-brand);
    font-size: 13px;
    font-weight: 700;
    color: white;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .footer-link {
    font-size: 14px;
    color: rgba(151, 146, 202, 0.85);
    text-decoration: none;
    transition: color 0.2s, transform 0.2s ease;
    display: inline-block;
  }

  .footer-link:hover {
    color: white;
    transform: translateX(4px);
  }

  /* Amazon CTA */
  .footer-amazon-cta {
    margin-top: 16px;
  }

  .footer-amazon-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(195, 192, 255, 0.3);
    border-radius: var(--radius-full);
    padding: 9px 18px;
    font-family: var(--font-brand);
    font-size: 13px;
    font-weight: 700;
    color: white;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .footer-amazon-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  /* Bottom */
  .footer-bottom {
    padding: 20px 0;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer-copy {
    font-size: 13px;
    color: rgba(151, 146, 202, 0.6);
  }

  .footer-made {
    font-family: var(--font-brand);
    font-size: 13px;
    color: rgba(151, 146, 202, 0.6);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .heart {
    animation: heartbeat 1.5s ease-in-out infinite;
  }

  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
